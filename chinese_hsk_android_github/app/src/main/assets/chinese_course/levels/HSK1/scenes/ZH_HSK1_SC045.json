  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC045_001",
      "speaker": "张伟",
      "zh": "张伟拿到第一个月的工资。",
      "pinyin": "Zhāngwěi nádào dìyígè yuè de gōngzī.",
      "tr": "Zhang Wei ilk aylık maaşını aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_003",
      "speaker": "张雨桐",
      "zh": "嗯，对。",
      "pinyin": "En, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_006",
      "speaker": "刘梅",
      "zh": "这是工资，对吗？",
      "pinyin": "Zhèshì gōngzī, duì ma?",
      "tr": "Bu, maaş mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_007",
      "speaker": "张雨桐",
      "zh": "没错，这是工资。",
      "pinyin": "Méicuò, zhèshì gōngzī.",
      "tr": "Evet, bu maaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_008",
      "speaker": "张乐乐",
      "zh": "请问，工资在哪儿？",
      "pinyin": "Qǐngwèn, gōngzī zài nǎér?",
      "tr": "Maaş nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_009",
      "speaker": "张伟",
      "zh": "工资在这里。",
      "pinyin": "Gōngzī zài zhèlǐ.",
      "tr": "Maaş burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_010",
      "speaker": "刘梅",
      "zh": "这个是钱吗？",
      "pinyin": "Zhège shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_011",
      "speaker": "张雨桐",
      "zh": "嗯，这就是钱。",
      "pinyin": "En, zhè jiùshì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_012",
      "speaker": "张乐乐",
      "zh": "钱呢？",
      "pinyin": "Qián ne?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_013",
      "speaker": "张伟",
      "zh": "你看，钱在这儿。",
      "pinyin": "Nǐ kàn, qián zài zhèér.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_014",
      "speaker": "刘梅",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎnshàng yǒu shíjiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_015",
      "speaker": "张雨桐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_016",
      "speaker": "张乐乐",
      "zh": "晚上见。",
      "pinyin": "Wǎnshàng jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_017",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_018",
      "speaker": "刘梅",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yàofàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_019",
      "speaker": "张雨桐",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_020",
      "speaker": "张乐乐",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_021",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_022",
      "speaker": "刘梅",
      "zh": "大家想怎么庆祝。",
      "pinyin": "Dàjiā xiǎng zěnme qìngzhù.",
      "tr": "Herkes nasıl kutlayacağını düşünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_027",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_028",
      "speaker": "张乐乐",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_030",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_031",
      "speaker": "张雨桐",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_032",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_033",
      "speaker": "张伟",
      "zh": "那准备好了吗？",
      "pinyin": "Nà zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_034",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_035",
      "speaker": "张雨桐",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_036",
      "speaker": "张乐乐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_037",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_038",
      "speaker": "刘梅",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_039",
      "speaker": "张雨桐",
      "zh": "这是菜单，对吗？",
      "pinyin": "Zhèshì càidān, duì ma?",
      "tr": "Bu, menü mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_040",
      "speaker": "张乐乐",
      "zh": "对，这是菜单。",
      "pinyin": "Duì, zhèshì càidān.",
      "tr": "Evet, bu menü."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_041",
      "speaker": "张伟",
