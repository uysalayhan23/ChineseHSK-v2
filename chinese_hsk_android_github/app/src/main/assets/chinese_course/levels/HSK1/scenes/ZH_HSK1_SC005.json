    "pronunciationItems": [
      {
        "id": "PRON_ZH_HSK1_SC005_001",
        "zh": "让爸爸拿吧。",
        "pinyin": "Ràng bà ba ná ba.",
        "tr": "Bırak baban alsın.",
        "scoring": [
          "pronunciation",
          "toneAccuracy",
          "fluency",
          "timing",
          "completeness"
        ]
      },
      {
        "id": "PRON_ZH_HSK1_SC005_002",
        "zh": "是它！在座位下面！",
        "pinyin": "Shì tā! zài zuò wèi xià miàn!",
        "tr": "O! Koltuğun altında!",
        "scoring": [
