  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC005_001",
      "speaker": "张乐乐",
      "zh": "姐姐，我的玩具呢？",
      "pinyin": "Jiě jie, wǒ de wán jù ne?",
      "tr": "Abla, oyuncağım nerede?",
      "emotion": "worried",
      "actionTr": "Çantasının içini endişeyle kontrol eder."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_002",
      "speaker": "张雨桐",
      "zh": "你的小火车吗？",
      "pinyin": "Nǐ de xiǎo huǒ chē ma?",
      "tr": "Küçük oyuncak trenin mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_003",
      "speaker": "刘梅",
      "zh": "刚才不是在包里吗？",
      "pinyin": "Gāng cái bú shì zài bāo lǐ ma?",
      "tr": "Az önce çantada değil miydi?",
      "emotion": "curious",
      "actionTr": "Lele’nin çantasına bakar."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_004",
      "speaker": "张伟",
      "zh": "先看看你的包。",
      "pinyin": "Xiān kàn kàn nǐ de bāo.",
      "tr": "Önce çantana bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_005",
      "speaker": "张乐乐",
      "zh": "我看了，没有。",
      "pinyin": "Wǒ kàn le, méi yǒu.",
      "tr": "Baktım, yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_006",
      "speaker": "张雨桐",
      "zh": "小口袋也看了吗？",
      "pinyin": "Xiǎo kǒu dai yě kàn le ma?",
      "tr": "Küçük cebe de baktın mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_007",
      "speaker": "刘梅",
      "zh": "别急，慢慢找。",
      "pinyin": "Bié jí, màn màn zhǎo.",
      "tr": "Telaşlanma, yavaş yavaş arayalım.",
      "emotion": "comforting",
      "actionTr": "Sakin bir sesle oğluna yaklaşır."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_008",
      "speaker": "张伟",
      "zh": "吃早饭前，你拿出来了吗？",
      "pinyin": "Chī zǎo fàn qián, nǐ ná chū lái le ma?",
      "tr": "Kahvaltıdan önce çıkarmış mıydın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_009",
      "speaker": "张乐乐",
      "zh": "拿了，我想让它坐火车。",
      "pinyin": "Ná le, wǒ xiǎng ràng tā zuò huǒ chē.",
      "tr": "Çıkardım, o da trene binsin istedim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_010",
      "speaker": "张雨桐",
      "zh": "它坐在哪个座位上？",
      "pinyin": "Tā zuò zài nǎ ge zuò wèi shàng?",
      "tr": "Hangi koltuğa oturttun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_011",
      "speaker": "刘梅",
      "zh": "是你旁边的座位吗？",
      "pinyin": "Shì nǐ páng biān de zuò wèi ma?",
      "tr": "Yanındaki koltuk muydu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_012",
      "speaker": "张伟",
      "zh": "乐乐，你想一想。",
      "pinyin": "Lè le, nǐ xiǎng yī xiǎng.",
      "tr": "Lele, bir düşün."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_013",
      "speaker": "张乐乐",
      "zh": "嗯，在我的左边。",
      "pinyin": "Èn, zài wǒ de zuǒ biān.",
      "tr": "Evet, solumdaydı.",
      "emotion": "curious",
      "actionTr": "Solundaki koltuğu işaret eder."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_014",
      "speaker": "张雨桐",
      "zh": "现在左边只有你的书。",
      "pinyin": "Xiàn zài zuǒ biān zhǐ yǒu nǐ de shū.",
      "tr": "Şimdi solunda sadece kitabın var."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_015",
      "speaker": "刘梅",
      "zh": "把书拿起来看看。",
      "pinyin": "Bǎ shū ná qǐ lái kàn kàn.",
      "tr": "Kitabı kaldırıp bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_016",
      "speaker": "张伟",
      "zh": "我帮你拿着包。",
      "pinyin": "Wǒ bāng nǐ ná zhe bāo.",
      "tr": "Çantanı ben tutayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_017",
      "speaker": "张乐乐",
      "zh": "书下面也没有。",
      "pinyin": "Shū xià miàn yě méi yǒu.",
      "tr": "Kitabın altında da yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_018",
      "speaker": "张雨桐",
      "zh": "会不会在座位下面？",
      "pinyin": "Huì bú huì zài zuò wèi xià miàn?",
      "tr": "Koltuğun altında olabilir mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_019",
      "speaker": "刘梅",
      "zh": "你坐好，我来找。",
      "pinyin": "Nǐ zuò hǎo, wǒ lái zhǎo.",
      "tr": "Sen düzgün otur, ben arayayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_020",
      "speaker": "张伟",
      "zh": "我看看右边。",
      "pinyin": "Wǒ kàn kàn yòu biān.",
      "tr": "Ben de sağa bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_021",
      "speaker": "张乐乐",
      "zh": "爸爸，右边有吗？",
      "pinyin": "Bà ba, yòu biān yǒu ma?",
      "tr": "Baba, sağda var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_022",
      "speaker": "张雨桐",
      "zh": "别一直问，让爸爸看。",
      "pinyin": "Bié yì zhí wèn, ràng bà ba kàn.",
      "tr": "Durmadan sorma, babam baksın."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_023",
      "speaker": "刘梅",
      "zh": "你可以帮姐姐看看这边。",
      "pinyin": "Nǐ kě yǐ bāng jiě jie kàn kàn zhè biān.",
      "tr": "Ablanla bu tarafa bakabilirsin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_024",
      "speaker": "张伟",
      "zh": "右边没有小火车。",
      "pinyin": "Yòu biān méi yǒu xiǎo huǒ chē.",
      "tr": "Sağda küçük tren yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_025",
      "speaker": "张乐乐",
      "zh": "那我的玩具去哪儿了？",
      "pinyin": "Nà wǒ de wán jù qù nǎr le?",
      "tr": "Peki oyuncağım nereye gitti?",
      "emotion": "sad",
      "actionTr": "Boş ellerine bakar."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_026",
      "speaker": "张雨桐",
      "zh": "它又不会自己走。",
      "pinyin": "Tā yòu bú huì zì jǐ zǒu.",
      "tr": "Kendi kendine gidemez ya."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_027",
      "speaker": "刘梅",
      "zh": "也许掉下去了。",
      "pinyin": "Yě xǔ diào xià qù le.",
      "tr": "Belki yere düşmüştür."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_028",
      "speaker": "张伟",
      "zh": "左边下面还没看。",
      "pinyin": "Zuǒ biān xià miàn hái méi kàn.",
      "tr": "Sol alt tarafa daha bakmadık."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_029",
      "speaker": "张乐乐",
      "zh": "我去看左边！",
      "pinyin": "Wǒ qù kàn zuǒ biān!",
      "tr": "Sola ben bakayım!",
      "emotion": "curious",
      "actionTr": "Sol tarafa bakmak için öne eğilir."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_030",
      "speaker": "张雨桐",
      "zh": "等一下，你的水在这儿。",
      "pinyin": "Děng yí xià, nǐ de shuǐ zài zhèr.",
      "tr": "Bir dakika, suyun burada.",
      "emotion": "worried",
      "actionTr": "Su şişesini tutup kardeşini durdurur."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_031",
      "speaker": "刘梅",
      "zh": "先把水放好。",
      "pinyin": "Xiān bǎ shuǐ fàng hǎo.",
      "tr": "Önce suyu düzgün koyalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_032",
      "speaker": "张伟",
      "zh": "好了，现在可以看。",
      "pinyin": "Hǎo le, xiàn zài kě yǐ kàn.",
      "tr": "Tamam, şimdi bakabiliriz."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_033",
      "speaker": "张乐乐",
      "zh": "下面黑黑的，我看不见。",
      "pinyin": "Xià miàn hēi hēi de, wǒ kàn bú jiàn.",
      "tr": "Altı karanlık, göremiyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_034",
      "speaker": "张雨桐",
      "zh": "爸爸，你有手机吗？",
      "pinyin": "Bà ba, nǐ yǒu shǒu jī ma?",
      "tr": "Baba, telefonun var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_035",
      "speaker": "刘梅",
      "zh": "用手机照一下吧。",
      "pinyin": "Yòng shǒu jī zhào yī xià ba.",
      "tr": "Telefonla biraz ışık tutalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_036",
      "speaker": "张伟",
      "zh": "好，你们别挡着光。",
      "pinyin": "Hǎo, nǐ men bié dǎng zhe guāng.",
      "tr": "Tamam, ışığın önünü kapatmayın.",
      "emotion": "neutral",
      "actionTr": "Telefonun ışığını koltuk altına tutar."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_037",
      "speaker": "张乐乐",
      "zh": "我看见一个轮子！",
      "pinyin": "Wǒ kàn jiàn yí gè lún zi!",
      "tr": "Bir tekerlek gördüm!",
      "emotion": "happy",
      "actionTr": "Gördüğü tekerleği heyecanla işaret eder."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_038",
      "speaker": "张雨桐",
      "zh": "在哪儿？我也想看。",
      "pinyin": "Zài nǎr? wǒ yě xiǎng kàn.",
      "tr": "Nerede? Ben de görmek istiyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_039",
      "speaker": "刘梅",
      "zh": "在座位下面，对吗？",
      "pinyin": "Zài zuò wèi xià miàn, duì ma?",
      "tr": "Koltuğun altında, değil mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_040",
      "speaker": "张伟",
      "zh": "对，不过是包的轮子。",
      "pinyin": "Duì, bù guò shì bāo de lún zi.",
      "tr": "Evet, ama çantanın tekerleği.",
      "emotion": "neutral",
      "actionTr": "Çantanın tekerleğini gösterir."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_041",
      "speaker": "张乐乐",
      "zh": "啊，不是我的玩具。",
      "pinyin": "A, bú shì wǒ de wán jù.",
      "tr": "Ah, benim oyuncağım değilmiş.",
      "emotion": "sad",
      "actionTr": "Oyuncağı olmadığını anlayıp yüzünü düşürür."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_042",
      "speaker": "张雨桐",
      "zh": "再往里面看一点。",
      "pinyin": "Zài wǎng lǐ miàn kàn yì diǎn.",
      "tr": "Biraz daha içeri bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_043",
      "speaker": "刘梅",
      "zh": "孩子们，头别碰到座位。",
      "pinyin": "Hái zi men, tóu bié pèng dào zuò wèi.",
      "tr": "Çocuklar, başınızı koltuğa çarpmayın."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_044",
      "speaker": "张伟",
      "zh": "这儿没有，再看旁边。",
      "pinyin": "Zhèr méi yǒu, zài kàn páng biān.",
      "tr": "Burada yok, yanına da bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_045",
      "speaker": "张乐乐",
      "zh": "是不是咪咪拿走了？",
      "pinyin": "Shì bú shì mī mī ná zǒu le?",
      "tr": "Acaba Mimi mi aldı?",
      "emotion": "curious",
      "actionTr": "Kedi çantasına bakar."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_046",
      "speaker": "张雨桐",
      "zh": "猫也喜欢你的小火车？",
      "pinyin": "Māo yě xǐ huan nǐ de xiǎo huǒ chē?",
      "tr": "Kedi de küçük trenini mi seviyor?",
      "emotion": "playful",
      "actionTr": "Kardeşine hafifçe gülümser."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_047",
      "speaker": "刘梅",
      "zh": "咪咪在猫包里睡觉呢。",
      "pinyin": "Mī mī zài māo bāo lǐ shuì jiào ne.",
      "tr": "Mimi taşıma çantasında uyuyor.",
      "emotion": "comforting",
      "actionTr": "Uyuyan kediyi sessizce gösterir."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_048",
      "speaker": "张伟",
      "zh": "看，猫包一直关着。",
      "pinyin": "Kàn, māo bāo yì zhí guān zhe.",
      "tr": "Bak, kedinin çantası hep kapalıydı."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_049",
      "speaker": "张乐乐",
      "zh": "那不是咪咪。",
      "pinyin": "Nà bú shì mī mī.",
      "tr": "O zaman Mimi almamış."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_050",
      "speaker": "张雨桐",
      "zh": "别把它叫醒了。",
      "pinyin": "Bié bǎ tā jiào xǐng le.",
      "tr": "Onu uyandırmayalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_051",
      "speaker": "刘梅",
      "zh": "我们小声一点。",
      "pinyin": "Wǒ men xiǎo shēng yì diǎn.",
      "tr": "Biraz alçak sesle konuşalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_052",
      "speaker": "张伟",
      "zh": "乐乐，早饭时玩具在哪里？",
      "pinyin": "Lè le, zǎo fàn shí wán jù zài nǎ lǐ?",
      "tr": "Lele, kahvaltıda oyuncak neredeydi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_053",
      "speaker": "张乐乐",
      "zh": "我放在座位上了。",
      "pinyin": "Wǒ fàng zài zuò wèi shàng le.",
      "tr": "Koltuğun üstüne koydum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_054",
      "speaker": "张雨桐",
      "zh": "后来你拿面包了。",
      "pinyin": "Hòu lái nǐ ná miàn bāo le.",
      "tr": "Sonra ekmeğini aldın."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_055",
      "speaker": "刘梅",
      "zh": "拿面包时，包也动了。",
      "pinyin": "Ná miàn bāo shí, bāo yě dòng le.",
      "tr": "Ekmeği alırken çanta da hareket etti."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_056",
      "speaker": "张伟",
      "zh": "那玩具可能在包旁边。",
      "pinyin": "Nà wán jù kě néng zài bāo páng biān.",
      "tr": "O zaman oyuncak çantanın yanında olabilir."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_057",
      "speaker": "张乐乐",
      "zh": "姐姐，你的包在左边。",
      "pinyin": "Jiě jie, nǐ de bāo zài zuǒ biān.",
      "tr": "Abla, çantan solda.",
      "emotion": "curious",
      "actionTr": "Ablasının solundaki çantayı işaret eder."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_058",
      "speaker": "张雨桐",
      "zh": "我把它拿开，你看下面。",
      "pinyin": "Wǒ bǎ tā ná kāi, nǐ kàn xià miàn.",
      "tr": "Ben onu kaldırayım, sen altına bak.",
      "emotion": "neutral",
      "actionTr": "Çantayı yavaşça kaldırır."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_059",
      "speaker": "刘梅",
      "zh": "慢一点，东西别掉出来。",
      "pinyin": "Màn yì diǎn, dōng xi bié diào chū lái.",
      "tr": "Yavaş ol, eşyalar dışarı dökülmesin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_060",
      "speaker": "张伟",
      "zh": "我来扶着包。",
      "pinyin": "Wǒ lái fú zhe bāo.",
      "tr": "Çantayı ben tutayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_061",
      "speaker": "张乐乐",
      "zh": "这里有个红色的东西！",
      "pinyin": "Zhè lǐ yǒu gè hóng sè de dōng xi!",
      "tr": "Burada kırmızı bir şey var!",
      "emotion": "happy",
      "actionTr": "Kırmızı oyuncağı fark eder."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_062",
      "speaker": "张雨桐",
      "zh": "是小火车吗？",
      "pinyin": "Shì xiǎo huǒ chē ma?",
      "tr": "Küçük tren mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_063",
      "speaker": "刘梅",
      "zh": "你先看清楚。",
      "pinyin": "Nǐ xiān kàn qīng chǔ.",
      "tr": "Önce dikkatlice bak."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_064",
      "speaker": "张伟",
      "zh": "我把灯照过去。",
      "pinyin": "Wǒ bǎ dēng zhào guò qù.",
      "tr": "Işığı o tarafa tutayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_065",
      "speaker": "张乐乐",
      "zh": "是它！在座位下面！",
      "pinyin": "Shì tā! zài zuò wèi xià miàn!",
      "tr": "O! Koltuğun altında!",
      "emotion": "happy",
      "actionTr": "Koltuğun altındaki treni heyecanla gösterir."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_066",
      "speaker": "张雨桐",
      "zh": "原来在我的包后面。",
      "pinyin": "Yuán lái zài wǒ de bāo hòu miàn.",
      "tr": "Meğer benim çantamın arkasındaymış."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_067",
      "speaker": "刘梅",
      "zh": "乐乐，手够得到吗？",
      "pinyin": "Lè le, shǒu gòu de dào ma?",
      "tr": "Lele, elin yetişiyor mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_068",
      "speaker": "张伟",
      "zh": "够不到的话，爸爸帮你。",
      "pinyin": "Gòu bú dào de huà, bà ba bāng nǐ.",
      "tr": "Yetişmiyorsa baban yardım etsin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_069",
      "speaker": "张乐乐",
      "zh": "差一点点，够不到。",
      "pinyin": "Chà yì diǎn diǎn, gòu bú dào.",
      "tr": "Çok az kaldı ama yetişmiyor.",
      "emotion": "worried",
      "actionTr": "Elini uzatıp yetişemediğini fark eder."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_070",
      "speaker": "张雨桐",
      "zh": "别趴下，地上脏。",
      "pinyin": "Bié pā xià, dì shàng zàng.",
      "tr": "Yere yatma, yer kirli."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_071",
      "speaker": "刘梅",
      "zh": "让爸爸拿吧。",
      "pinyin": "Ràng bà ba ná ba.",
      "tr": "Bırak baban alsın."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_072",
      "speaker": "张伟",
      "zh": "找到了，是你的那辆小火车吗？",
      "pinyin": "Zhǎo dào le, shì nǐ de nà liàng xiǎo huǒ chē ma?",
      "tr": "Buldum, senin küçük trenin mi?",
      "emotion": "playful",
      "actionTr": "Oyuncağı çıkarıp gülümseyerek uzatır."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_073",
      "speaker": "张乐乐",
      "zh": "我的！谢谢爸爸！",
      "pinyin": "Wǒ de! Xiè xie bà ba!",
      "tr": "Benim! Teşekkür ederim baba!",
      "emotion": "happy",
      "actionTr": "Oyuncağını sevinçle alır."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_074",
      "speaker": "张雨桐",
      "zh": "这下不着急了吧？",
      "pinyin": "Zhè xià bù zháo jí le ba?",
      "tr": "Artık telaşın kalmadı, değil mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_075",
      "speaker": "刘梅",
      "zh": "看看玩具有没有坏。",
      "pinyin": "Kàn kàn wán jù yǒu méi yǒu huài.",
      "tr": "Oyuncakta bir şey kırılmış mı bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_076",
      "speaker": "张伟",
      "zh": "轮子还能转吗？",
      "pinyin": "Lún zi hái néng zhuǎn ma?",
      "tr": "Tekerlekleri hâlâ dönebiliyor mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_077",
      "speaker": "张乐乐",
      "zh": "能转，没坏！",
      "pinyin": "Néng zhuǎn, méi huài!",
      "tr": "Dönebiliyor, kırılmamış!",
      "emotion": "happy",
      "actionTr": "Trenin tekerleklerini çevirip kontrol eder."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_078",
      "speaker": "张雨桐",
      "zh": "那就好，先擦一擦。",
      "pinyin": "Nà jiù hǎo, xiān cā yī cā.",
      "tr": "İyi o zaman, önce bir silelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_079",
      "speaker": "刘梅",
      "zh": "给你纸，手也擦一下。",
      "pinyin": "Gěi nǐ zhǐ, shǒu yě cā yī xià.",
      "tr": "Al, ellerini de sil."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_080",
      "speaker": "张伟",
      "zh": "擦好了再玩。",
      "pinyin": "Cā hǎo le zài wán.",
      "tr": "Sildikten sonra oyna."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_081",
      "speaker": "张乐乐",
      "zh": "我想让它坐这里。",
      "pinyin": "Wǒ xiǎng ràng tā zuò zhè lǐ.",
      "tr": "Onu buraya oturtmak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_082",
      "speaker": "张雨桐",
      "zh": "这里是座位，不是路哦。",
      "pinyin": "Zhè lǐ shì zuò wèi, bú shì lù ó.",
      "tr": "Burası koltuk, yol değil ama."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_083",
      "speaker": "刘梅",
      "zh": "放在腿上，别再掉了。",
      "pinyin": "Fàng zài tuǐ shàng, bié zài diào le.",
      "tr": "Kucağına koy, yine düşmesin.",
      "emotion": "comforting",
      "actionTr": "Oyuncağı kucağında tutmasını gösterir."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_084",
      "speaker": "张伟",
      "zh": "我们的火车开，小火车休息。",
      "pinyin": "Wǒ men de huǒ chē kāi, xiǎo huǒ chē xiū xī.",
      "tr": "Bizim tren gitsin, küçük tren dinlensin.",
      "emotion": "playful",
      "actionTr": "Küçük trenin dinlendiğini söyleyip gülümser."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_085",
      "speaker": "张乐乐",
      "zh": "它也要看窗外。",
      "pinyin": "Tā yě yào kàn chuāng wài.",
      "tr": "O da pencereden dışarı bakmak istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_086",
      "speaker": "张雨桐",
      "zh": "那你拿好，我给它看。",
      "pinyin": "Nà nǐ ná hǎo, wǒ gěi tā kàn.",
      "tr": "Sen sıkıca tut, ben ona göstereyim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_087",
      "speaker": "刘梅",
      "zh": "看一会儿就放回包里。",
      "pinyin": "Kàn yī huì er jiù fàng huí bāo lǐ.",
      "tr": "Biraz baktıktan sonra çantaya geri koy."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_088",
      "speaker": "张伟",
      "zh": "下车时，我们还要拿行李。",
      "pinyin": "Xià chē shí, wǒ men hái yào ná xíng lǐ.",
      "tr": "İnerken bavulları da almamız gerekecek."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_089",
      "speaker": "张乐乐",
      "zh": "好，我把玩具放进包。",
      "pinyin": "Hǎo, wǒ bǎ wán jù fàng jìn bāo.",
      "tr": "Tamam, oyuncağı çantaya koyuyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_090",
      "speaker": "张雨桐",
      "zh": "放在哪个口袋？",
      "pinyin": "Fàng zài nǎ ge kǒu dai?",
      "tr": "Hangi cebe koyuyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_091",
      "speaker": "刘梅",
      "zh": "记住位置，下次就好找了。",
      "pinyin": "Jì zhù wèi zhì, xià cì jiù hǎo zhǎo le.",
      "tr": "Yerini hatırlarsan bir dahaki sefer kolay bulursun."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_092",
      "speaker": "张伟",
      "zh": "也让姐姐看看。",
      "pinyin": "Yě ràng jiě jie kàn kàn.",
      "tr": "Ablana da göster."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_093",
      "speaker": "张乐乐",
      "zh": "左边这个，大口袋。",
      "pinyin": "Zuǒ biān zhè ge, dà kǒu dai.",
      "tr": "Soldaki şu büyük cebe."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_094",
      "speaker": "张雨桐",
      "zh": "看到了，我帮你拉上。",
      "pinyin": "Kàn dào le, wǒ bāng nǐ lā shàng.",
      "tr": "Gördüm, fermuarını kapatayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_095",
      "speaker": "刘梅",
      "zh": "好了，玩具不会掉出来了。",
      "pinyin": "Hǎo le, wán jù bú huì diào chū lái le.",
      "tr": "Tamam, artık oyuncak dışarı düşmez."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_096",
      "speaker": "张伟",
      "zh": "你们一起找到它，真不错。",
      "pinyin": "Nǐ men yì qǐ zhǎo dào tā, zhēn bù cuò.",
      "tr": "Onu birlikte buldunuz, çok güzel.",
