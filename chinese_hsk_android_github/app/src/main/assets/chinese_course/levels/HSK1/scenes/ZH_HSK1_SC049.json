  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC049_001",
      "speaker": "张伟",
      "zh": "我们来新城三个月了。",
      "pinyin": "Wǒmen lái xīnchéng sāngè yuè le.",
      "tr": "Yeni kasabaya geleli üç ay oldu."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_003",
      "speaker": "张雨桐",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_006",
      "speaker": "刘梅",
      "zh": "三个月了。",
      "pinyin": "Sāngè yuè le.",
      "tr": "Üç ay oldu."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_007",
      "speaker": "张雨桐",
      "zh": "时间真快。",
      "pinyin": "Shíjiān zhēn kuài.",
      "tr": "Zaman gerçekten hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_008",
      "speaker": "张乐乐",
      "zh": "是啊。",
      "pinyin": "Shì a.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_009",
      "speaker": "张伟",
      "zh": "我们很喜欢这里。",
      "pinyin": "Wǒmen hěn xǐhuān zhèlǐ.",
      "tr": "Burayı çok seviyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_010",
      "speaker": "刘梅",
      "zh": "新城呢？",
      "pinyin": "Xīnchéng ne?",
      "tr": "Yeni şehir / kasaba nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_011",
      "speaker": "张雨桐",
      "zh": "你看，新城在那边。",
      "pinyin": "Nǐ kàn, xīnchéng zài nàbiān.",
      "tr": "Yeni şehir / kasaba şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_012",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_013",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_014",
      "speaker": "刘梅",
      "zh": "这个是旧的吗？",
      "pinyin": "Zhège shì jiù de ma?",
      "tr": "Bu, eski mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_015",
      "speaker": "张雨桐",
      "zh": "对，这是旧的。",
      "pinyin": "Duì, zhè shì jiù de.",
      "tr": "Evet, bu eski."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_016",
      "speaker": "张乐乐",
      "zh": "旧的在哪儿？",
      "pinyin": "Jiù de zài nǎér?",
      "tr": "Eski nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_017",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Eski burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_018",
      "speaker": "刘梅",
      "zh": "这个是新的吗？",
      "pinyin": "Zhège shì xīn de ma?",
      "tr": "Bu, yeni mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_019",
      "speaker": "张雨桐",
      "zh": "嗯，这就是新的。",
      "pinyin": "En, zhè jiùshì xīn de.",
      "tr": "Evet, bu yeni."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_020",
      "speaker": "张乐乐",
      "zh": "新的在哪儿？",
      "pinyin": "Xīn de zài nǎér?",
      "tr": "Yeni nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_021",
      "speaker": "张伟",
      "zh": "新的在这里。",
      "pinyin": "Xīn de zài zhèlǐ.",
      "tr": "Yeni burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_022",
      "speaker": "刘梅",
      "zh": "大家想起以前的生活。",
      "pinyin": "Dàjiā xiǎngqǐ yǐqián de shēnghuó.",
      "tr": "Herkes eski yaşamını hatırlıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_027",
      "speaker": "张雨桐",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_028",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_029",
      "speaker": "张伟",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_030",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_031",
      "speaker": "张雨桐",
      "zh": "学校呢？",
      "pinyin": "Xuéxiào ne?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_032",
      "speaker": "张乐乐",
      "zh": "学校在那边。",
      "pinyin": "Xuéxiào zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_033",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_035",
      "speaker": "张雨桐",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_036",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_037",
      "speaker": "张伟",
      "zh": "那准备得怎么样了？",
      "pinyin": "Nà zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_038",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_039",
      "speaker": "张雨桐",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_040",
      "speaker": "张乐乐",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_041",
      "speaker": "张伟",
      "zh": "太好了，认识你很高兴。",
