  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC029_001",
      "speaker": "张伟",
      "zh": "张伟来参加工作面试。",
      "pinyin": "Zhāngwěilái cānjiā gōngzuò miànshì.",
      "tr": "Zhang Wei iş görüşmesine geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_002",
      "speaker": "经理",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_003",
      "speaker": "公司职员",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_004",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_006",
      "speaker": "经理",
      "zh": "今天有面试吗？",
      "pinyin": "Jīntiān yǒu miànshì ma?",
      "tr": "Bugün iş görüşmesi var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_007",
      "speaker": "公司职员",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_008",
      "speaker": "张伟",
      "zh": "那准备好了吗？",
      "pinyin": "Nà zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_010",
      "speaker": "经理",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_011",
      "speaker": "公司职员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_012",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_013",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_014",
      "speaker": "经理",
      "zh": "这是我们的经理。",
      "pinyin": "Zhèshì wǒmen de jīnglǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_015",
      "speaker": "公司职员",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_016",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_017",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_018",
      "speaker": "经理",
      "zh": "办公室呢？",
      "pinyin": "Bàngōngshì ne?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_019",
      "speaker": "公司职员",
      "zh": "办公室在那边。",
      "pinyin": "Bàngōngshì zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_020",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_022",
      "speaker": "经理",
      "zh": "他要介绍自己会做什么。",
      "pinyin": "Tā yào jièshào zìjǐ huì zuò shénme.",
      "tr": "Neler yapabildiğini anlatması gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_023",
      "speaker": "公司职员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_026",
      "speaker": "经理",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_027",
      "speaker": "公司职员",
      "zh": "这是电脑，对吗？",
      "pinyin": "Zhèshì diànnǎo, duì ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_028",
      "speaker": "张伟",
      "zh": "嗯，这就是电脑。",
      "pinyin": "En, zhè jiùshì diànnǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_029",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diànnǎo zài nǎér?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_030",
      "speaker": "经理",
      "zh": "你看，电脑在这儿。",
      "pinyin": "Nǐ kàn, diànnǎo zài zhèér.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_031",
      "speaker": "公司职员",
      "zh": "这个是卡吗？",
      "pinyin": "Zhège shì kǎ ma?",
      "tr": "Bu, kart mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_032",
      "speaker": "张伟",
      "zh": "嗯，这就是卡。",
      "pinyin": "En, zhè jiùshì kǎ.",
      "tr": "Evet, bu kart."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_033",
      "speaker": "张伟",
      "zh": "卡呢？",
      "pinyin": "Kǎ ne?",
      "tr": "Kart nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_034",
      "speaker": "经理",
      "zh": "你看，卡在这儿。",
      "pinyin": "Nǐ kàn, kǎ zài zhèér.",
      "tr": "Kart burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_035",
      "speaker": "公司职员",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_036",
      "speaker": "张伟",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_037",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_038",
      "speaker": "经理",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_039",
      "speaker": "公司职员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_040",
      "speaker": "张伟",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_041",
      "speaker": "张伟",
